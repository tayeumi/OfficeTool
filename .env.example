# Biến môi trường cho docker-compose.yml (stack Redis + API OfficeTool).
# Copy sang `.env` khi chạy `docker compose up` thủ công, hoặc nhập trực tiếp
# vào form "Environment variables" khi tạo Stack trên Portainer.

# Image kéo từ GHCR (được build & push tự động bởi
# .github/workflows/docker-publish.yml mỗi khi có thay đổi trong api/).
# Đổi sang tag theo commit SHA cụ thể (vd ghcr.io/tayeumi/officetool:<sha>) để
# pin version hoặc rollback mà không cần sửa docker-compose.yml.
OFFICETOOL_IMAGE=ghcr.io/tayeumi/officetool:latest

# Port trên host map vào container (container luôn lắng nghe ở port 3000 nội
# bộ). Reverse proxy (Nginx/Nginx Proxy Manager) trỏ về port này.
OFFICETOOL_PORT=30003

# Model AI dùng cho tool "OCR PDF sang Word (AI)" (Gemini/Claude/GPT) được
# admin khai báo trực tiếp qua trang "/officetool/ai-models" trong ứng dụng
# (lưu vào storage-data volume, không qua biến môi trường) - không cần cấu
# hình gì thêm ở đây.
